{
  "name": "update-issue-body",
  "version": "1.1.0",
  "description": "Update an issue body",
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc && ncc build",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julien-deramond/update-issue-body.git"
  },
  "keywords": [
    "actions",
    "update",
    "issues"
  ],
  "author": "Julien Déramond",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/julien-deramond/update-issue-body/issues"
  },
  "homepage": "https://github.com/julien-deramond/update-issue-body#readme",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^5.59.6",
    "@typescript-eslint/parser": "^5.59.6",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^8.40.0",
    "eslint-plugin-github": "^4.7.0",
    "eslint-plugin-jest": "^27.2.1",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "js-yaml": "^4.3.2",
    "prettier": "^2.8.8",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "undici": "^6.29.1"
  }
}
